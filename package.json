{
  "name": "figma-copy-comments",
  "private": true,
  "description": "Figma plugin that copies comments between files, such as from commercial Figma to Figma for Government.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "node scripts/build.mjs --with-tests && node --test test/logic.test.js test/main.test.js",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@figma/eslint-plugin-figma-plugins": "1.0.0",
    "@figma/plugin-typings": "1.141.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
